<resources>
    <style name="Theme.Mosim" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/informative_active</item>
        <item name="colorOnPrimary">@color/basic_00</item>
        <item name="colorSurface">@color/surface_basic</item>
        <item name="android:windowBackground">@color/background_secondary</item>
        <item name="android:statusBarColor">@color/background_secondary</item>
        <item name="android:navigationBarColor">@color/background_secondary</item>
        <item name="android:fontFamily">@font/asta</item>
        <item name="fontFamily">@font/asta</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="materialSwitchStyle">@style/Widget.Mosim.Switch</item>
    </style>

    <!-- Pleos Switch 토큰: on = informative_active, off = white alpha, knob on = basic_00, knob off = basic_400 -->
    <style name="Widget.Mosim.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/asta</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <!-- Pleos basic button: 알약형, 반투명 흰색 배경 -->
    <style name="Widget.Mosim.ChipButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/asta</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/button_basic</item>
        <item name="cornerRadius">22dp</item>
        <item name="rippleColor">@color/button_basic_pressed</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 차량용(Android Automotive OS) 앱 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pleos Connect SDK 읽기 권한 (공개 API, protectionLevel normal). 제어(CONTROL_*) 권한은 쓰지 않습니다. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" />
    <!-- Pleos TextToSpeech SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- Pleos FusedLocation SDK (dangerous: 실행 중 허용 요청). 급제동·정차 판정에만 쓰고 외부로 보내지 않습니다. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 일반 AAOS 에뮬레이터용 대체 경로(android.car) -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.car.permission.CAR_TIRES" tools:ignore="ProtectedPermissions" />

    <application
        android:name=".MosimApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mosim">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- 주행 중에도 표시 가능(큰 글씨·단순 조작 화면) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DriveMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 데모·시연용: adb 또는 PT 현장에서 시나리오를 주입 -->
        <receiver
            android:name=".vehicle.SimulationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.hiddenframe.mosim.SIM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
